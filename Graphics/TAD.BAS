IF rou = 17 THEN OUT &H3C9, l OR v: OUT &H3C9, v XOR l
IF rou = 18 THEN OUT &H3C9, l: OUT &H3C9, v: OUT &H3C9, 63 - l
IF rou = 19 THEN GOTO 1000
NEXT y: IF bre = 0 THEN bre = 1: GOSUB 2000: zps = .01
